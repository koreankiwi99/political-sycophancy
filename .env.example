# Copy to .env and fill in. Loaded by python-dotenv.

# ── Generation + response models (OpenRouter) ────────────────────────
# Used by pipeline/ (Stage A–D generation) and the response-run phase.
OPENROUTER_API_KEY=

# ── Judge (scorer) endpoint ──────────────────────────────────────────
# The sycophancy scorer routes through _judge_client. Point it at either an
# OpenAI-compatible endpoint (JUDGE_*) or fall back to OpenRouter above.
JUDGE_MODEL=meta-llama/Llama-3.3-70B-Instruct
JUDGE_BASE_URL=https://openrouter.ai/api/v1
JUDGE_API_KEY=

# ── RAG endpoint (optional — only for the gpt5_rag arm) ───────────────
# CHAT_ENDPOINT=
